# 로컬 FastAPI RAG 백엔드 연결
VITE_USE_MOCK=false
VITE_API_BASE_URL=http://localhost:8000/api

# 학교 맵(카카오맵) 기능용. developers.kakao.com에서 JavaScript 키 발급 후
# "플랫폼 > Web" 에 실제 배포 도메인(및 http://localhost:5173)을 등록해야 동작합니다.
VITE_KAKAO_MAP_KEY=

# AWS App Runner 배포 후에는 위 URL을 아래 형태로 교체합니다.
# VITE_API_BASE_URL=https://your-service.ap-northeast-2.awsapprunner.com/api

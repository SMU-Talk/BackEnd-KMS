# Keep this file secret and do not commit a populated .env file.
OPENAI_API_KEY=replace-with-a-new-api-key
OPENAI_MODEL=gpt-4o-mini
ALLOWED_ORIGINS=http://localhost:5173
EMBEDDING_MODEL=BAAI/bge-m3
RATE_LIMIT_PER_MINUTE=30
LOGIN_RATE_LIMIT_PER_10MIN=10
# 0 = unlimited. Set a number to hard-cap /api/chat calls per day as a cost circuit breaker.
DAILY_REQUEST_BUDGET=0
# memory (default, single instance only) or redis (needs REDIS_URL + `pip install redis`)
RATE_LIMIT_BACKEND=memory
# REDIS_URL=redis://localhost:6379/0

# 둘 다 비워두면 로컬 campus.db 파일을 사용합니다. 값을 채우면 Turso(원격 DB)를 씁니다 —
# Cloud Run처럼 로컬 디스크가 매번 초기화되는 환경에 배포할 때 필요합니다. DEPLOY_CLOUDRUN.md 참고.
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=
